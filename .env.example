# Copy to .env (never commit it) and load with `set -a; . ./.env; set +a`.
DATABASE_URL=postgres://buwiz_cloud:buwiz_cloud@127.0.0.1:54330/buwiz_cloud
# 32 random bytes, base64: openssl rand -base64 32
DOCUMENT_KEY=
# Where the account site is served. Device sign-in links point here.
ACCOUNT_ORIGIN=http://localhost:3008
# Other hostnames serving this app, comma-separated (e.g. https://api.buwiz.com).
EXTRA_ORIGINS=
# Accounts that review TIN claims, comma-separated.
ADMIN_EMAILS=
# Sign-in codes are sent with Resend when RESEND_API_KEY is set and printed
# to the log when it is not. MAIL_TRANSPORT=log or =resend overrides that.
MAIL_TRANSPORT=
RESEND_API_KEY=
MAIL_FROM=Buwiz <signin@buwiz.com>
# Tickets for submission v2: base64 32-byte Ed25519 seed (openssl rand -base64 32).
TICKET_SIGNING_KEY=
# The Sender on the private network. Unset in development runs one in this
# process with the BIR_* settings below; required on public deployments.
SENDER_URL=
SENDER_SECRET=
# Submission relay (the Sender's settings). See docs/relay-protocol.md.
# The Sender also needs TICKET_PUBLIC_KEYS and SENDER_HPKE_KEY.
BIR_RELAY_MODE=dry_run
BIR_IAF_PASSPHRASE=
BIR_DISPATCHER_PASSPHRASE=
BIR_SSH_HOST_KEYS=
BIR_SFTP_HOSTS=ebf2.bir.gov.ph
BIR_LAB_SFTP=
# Base64 32-byte Ed25519 seed that signs receipts: openssl rand -base64 32
RECEIPT_SIGNING_KEY=
# Claim documents: S3-compatible storage (Cloudflare R2). Unset in
# development stores them in Postgres; required on public deployments.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
HOST=127.0.0.1
PORT=3008
RUST_LOG=info
